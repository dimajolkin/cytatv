# Build artifacts (images) — not source
/build/

# локальные SSH-ключи (генерация: q22e keys)
/assets/ssh/*
!/assets/ssh/.keep

*.img
*.IMG
*.upk
*.apk
*.dmg
*.tar.bz2
*.tar.gz

**/id_ed25519
**/id_ed25519_q22e

# UART capture (q22e uart)
/logs/*
!/logs/.gitkeep
docs/boot-log-*.txt
.DS_Store
.idea/
**/__pycache__/
*.pyc

# локальные оверлеи конфигов (секреты / machine-specific)
/configs/*.local.yaml
