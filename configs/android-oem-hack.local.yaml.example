# Локальный оверлей для android-oem-hack.yaml (gitignore).
# Скопируй в android-oem-hack.local.yaml и правь.
# Merge через github.com/yaml/go-yaml-dom: maps рекурсивно, списки — replace.

flash:
  disk: disk4
  force: true
  verify: true

# Дефолтный Wi‑Fi после wipe userdata (Settings сидит из /system/etc/wifi/cytatv_default.conf).
wifi:
  ssid: YourSSID
  psk: "YourPassword"
  # key_mgmt: WPA-PSK   # или NONE для открытой сети
